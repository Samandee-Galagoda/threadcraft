# Copy to .env and fill in. Nothing here is a real secret.

ENV=dev

# Local dev default is SQLite (no setup needed). Production uses Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/threadcraft
DATABASE_URL=sqlite:///./threadcraft.db

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]

ADMIN_EMAIL=admin@threadcraft.lk
ADMIN_PASSWORD=ChangeMe123!
DEMO_EMAIL=demo@threadcraft.lk
DEMO_PASSWORD=Demo1234!

# --- Optional integrations: leave blank in development, each falls back gracefully ---

# Cloudflare Workers AI (primary AI mockup provider)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Hugging Face Inference (fallback AI mockup provider)
HF_TOKEN=

# --- Trained models on the Hugging Face Hub ---
# Set HF_USERNAME and the three repo IDs default to the training notebooks'
# output names. Override individually only if you renamed a repo.
HF_USERNAME=
# HF_CLASSIFIER_MODEL=you/threadcraft-garment-classifier
# HF_MEASUREMENT_MODEL=you/threadcraft-measurement-predictor
# HF_FIT_MODEL=you/threadcraft-fit-recommender

# Requires: pip install -r requirements-ml.txt
ML_ENABLED=true
# The ViT classifier pulls torch (~800 MB) — too big for most free tiers, so
# it is opt-in separately from the two small scikit-learn models.
ML_ENABLE_CLASSIFIER=false

# Cloudflare R2 (object storage for uploads + generated mockups)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Stripe (test mode). Leave blank and checkout runs in simulated mode: orders
# are marked paid without a charge, so the flow is demoable with no account.
# Anything here must be a TEST key (sk_test_...) — this project never handles
# live card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Where Stripe returns the customer. Both get ?order=<number> appended, and the
# success URL also gets &session_id=... — set these to the deployed frontend.
CHECKOUT_SUCCESS_URL=http://localhost:5173/success
CHECKOUT_CANCEL_URL=http://localhost:5173/success

# Resend (transactional email)
RESEND_API_KEY=
