# rather than being mixed into the one that mirrors the deployment.
.venv-classifier/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# ── Node ───────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/
frontend/stats.html

